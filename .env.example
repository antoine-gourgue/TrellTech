# ─── API (apps/api) ───────────────────────────────────────────────
# Base de données PostgreSQL (docker-compose fournit ces valeurs par défaut)
DATABASE_URL="postgresql://trelltech:trelltech@localhost:5432/trelltech?schema=public"

# Trello — À OBTENIR sur https://trello.com/power-ups/admin
# Ces secrets restent côté SERVEUR uniquement, jamais exposés au navigateur.
TRELLO_API_KEY="votre_cle_api_trello"
TRELLO_API_SECRET="votre_secret_trello"

# OAuth : URL de retour vers l'API après autorisation Trello
TRELLO_OAUTH_CALLBACK_URL="http://localhost:4000/api/auth/trello/callback"

# Secret de signature des sessions (générer : openssl rand -hex 32)
SESSION_SECRET="changez_moi_en_production"

# Origine du front autorisée pour CORS
WEB_ORIGIN="http://localhost:3000"

# Port de l'API
PORT=4000

# ─── Web (apps/web) ───────────────────────────────────────────────
# URL publique de l'API consommée par le front
NEXT_PUBLIC_API_URL="http://localhost:4000"
# URL publique du site (métadonnées, liens absolus)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Production (docker-compose.prod.yml → .env.production) ────────
# Copier ce fichier vers .env.production sur le VPS, puis renseigner
# les valeurs réelles. .env.production est gitignoré : jamais commité.
#
# POSTGRES_USER="trelltech"
# POSTGRES_PASSWORD="genere_un_mot_de_passe_fort"
# POSTGRES_DB="trelltech"
#
# Le host de la base est le nom du service compose (db), pas localhost.
# DATABASE_URL="postgresql://trelltech:genere_un_mot_de_passe_fort@db:5432/trelltech?schema=public"
#
# SESSION_SECRET="openssl rand -hex 32"
# WEB_ORIGIN="https://ton-domaine.example"
# NEXT_PUBLIC_API_URL="https://api.ton-domaine.example"
# NEXT_PUBLIC_SITE_URL="https://ton-domaine.example"
#
# Ports exposés sur le VPS (défauts : 4000 / 3000)
# API_PORT="4000"
# WEB_PORT="3000"
